# ---- Pico assistant: add these lines to LavaLust's .env (the one next to app/ and public/) ----

# Required. Create a key at https://console.anthropic.com/ and keep it ONLY here.
PICO_ANTHROPIC_API_KEY=

# Optional (defaults shown)
# PICO_MODEL=claude-haiku-5-5
# PICO_MAX_TOKENS=300
# PICO_TIMEOUT=25

# Per-client limit: this many chat requests per window (seconds). 0 turns it off.
# PICO_RATE_LIMIT=20
# PICO_RATE_WINDOW=60
# Set to 1 only if LavaLust sits behind a proxy you control (uses X-Forwarded-For for the limit)
# PICO_TRUST_PROXY=0

# Extra instructions appended to Pico's personality, e.g. facts about your product
# PICO_SYSTEM_EXTRA=You are the helper for Acme Orders. Keep answers about orders and shipping.

# Cross-origin only (see snippets/config.pico.php). Comma separated, no trailing slash.
# PICO_ALLOWED_ORIGINS=https://app.example.com

# Testing only: point at a mock instead of api.anthropic.com
# PICO_API_BASE=https://api.anthropic.com
